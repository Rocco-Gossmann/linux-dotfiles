(defcfg
  ;; For Linux
  input  (device-file "/dev/input/by-id/usb-04f3_ELAN_Touchpad_and_Keyboard-event-kbd" :ignore-missing true)
  output (uinput-sink "My KMonad output"
    ;; To understand the importance of the following line, see the section on
    ;; Compose-key sequences at the near-bottom of this file.
    "sleep 1 && setxkbmap -option compose:ralt")
  cmp-seq ralt    ;; Set the compose key to `RightAlt'
  cmp-seq-delay 5 ;; 5ms delay between each compose-key sequence press
  key-seq-delay 5 ;; 5ms delay between each outputted key event

  ;; Comment this if you want unhandled events not to be emitted
  fallthrough true

  ;; Set this to false to disable any command-execution in KMonad
  allow-cmd true

  ;; Set the implicit around to `around`
  implicit-around around
)


(defalias
  eschpr (tap-next esc (layer-toggle capshypr))
  Co   RA-7                   ;; {
  Bo   RA-8                   ;; [
  Bc   RA-9                   ;; ]
  Cc   RA-0                   ;; }
  LsG  S-lsgt                 ;; >
  LsP  RA-lsgt                ;; Pipe |
  BkSl RA--                   ;; Backslash
  ArF  (tap-macro S-0 S-lsgt) ;; Fat Arrow
  ArT  (tap-macro / S-lsgt)   ;; Thin Arrow
  Crt  (tap-macro S-= S-spc)  ;; `
)

(defsrc
  esc   f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12   sleep  del
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    q    w    e    r    t    y    u    i    o    p    [    ]    ret
  caps   a    s    d    f    g    h    j    k    l    ;    '    \
  lsft  lsgt  z    x    c    v    b    n    m    ,    .    /    rsft
  lctl  lmet lalt            spc                 ralt rmet cmp  rctl
)

(deflayer default
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12   sleep  del
  grv     1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab     q    w    e    r    t    y    u    i    o    p    [    ]    ret
  @eschpr a    s    d    f    g    h    j    k    l    ;    '    \
  lsft   lsgt  z    x    c    v    b    n    m    ,    .    /    rsft
  lctl   lmet lalt            spc                 ralt rmet cmp  rctl
)

(deflayer capshypr
  esc  f1   f2   f3   f4   f5   f6      f7     f8     f9    f10  f11    f12  sleep  del
  grv   1    2    3    4    5    6      7      8      9     0    -      =    bspc
  tab   q    w    e    r    t    @Co    @Bo    @Bc    @Cc   p    [      @Crt    @ArF 
  _     a    s    d    f    g    left   down    up    right     ;    '      @ArT
  lsft lsgt  z    x    c    v    b     lsgt    @LsG   @LsP  .    @BkSl    rsft
  lctl lmet lalt            spc                 ralt rmet cmp  rctl
)