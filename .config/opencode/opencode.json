{
	"$schema": "https://opencode.ai/config.json",
	"model": "ollama.homenet/glm-4.7-flash:8th_30kc",

	"agent": {

		"research": {
			"prompt": "{file:./prompts/research.md}"
		}

	},

	"provider": {

		"ollama.local": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama (Local)",
			"options": {
				"baseURL": "http://localhost:11434/v1"
			},
			"models": {
				"qwen3:1.7b-q8_0": { "name": "Qwen3 1.7B (Q8) " },
				"granite4:3b": { "name": "Granite4 3B" }
			}
		},

		"ollama.homenet": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama (HomeNet)",
			"options": {
				"baseURL": "http://homemac:11434/v1"
			},
			"models": {
				"glm-4.7-flash:local": {
					"name": "GLM-4.7-Flash"
				},
				"lfm2:24b:local": {
					"name": "LFM 2 24B"
				},
				"qwen3-coder:30b:local": {
					"name": "Qwen3-Coder 30B"
				},
				"gpt-oss:20b:local": {
					"name": "GPT-OSS 20B"
				},
				"nqc:local": {
					"name": "Neuralquantum Coder Latest"
				}
			}
		}
	},

	"keybinds": {
		"input_newline": "return",
		"input_submit": "alt+return"
	}
}
