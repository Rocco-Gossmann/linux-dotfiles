{
	"$schema": "https://opencode.ai/config.json",
	"model": "ollama.local/granite4:3b",

	"agent": {

		"research": {
			"model": "ollama.homenet/gpt-oss:20b",
			"prompt": "{file:./prompts/research.md}"
		}

	},

	"provider": {
		"lmstudio.homenet": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "LMStudio (HomeNet)",
			"options": {
				"baseURL": "http://homemac:1234/v1"
			},
			"models": {
				"loaded": {
					"name": "What ever LMStudio has currently loaded"
				}
			}
		},

		"ollama.local": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama (Local)",
			"options": {
				"baseURL": "http://localhost:11434/v1"
			},
			"models": {
				"qwen3:1.7b-q8_0": { "name": "Qwen3 1.7B" },
				"granite4:3b": { "name": "Granite4 3B" }
			}
		},

		"ollama.homenet": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama (HomeNet)",
			"options": {
				"baseURL": "http://homemac:11434/v1"
			},
			"models": {
				"nqc:5th_32kc": {
					"name": "Neuralquantum-Coder (5 Threads 32K Context)"
				},
				"nqc:6th_32kc": {
					"name": "Neuralquantum-Coder (6 Threads 32K Context)"
				},
				"glm-4.7-flash:5th_32kc": {
					"name": "GLM 4.7 Flash (5 Threads 32K Context)"
				},
				"glm-4.7-flash:latest": {
					"name": "GLM 4.7 Flash (latest)"
				},
				"qwen3-coder:30b_q4_5th_32kc": {
					"name": "Qwen3-Coder 30b Q4 (5 Threads 32K Context)"
				},
				"qwen3:4b_5th_32kc": {
					"name": "Qwen3 4B (5 Threads 32K Context)",
					"extra_body": {
						"enable_thinking": false
					}
				},
				"qwen3:8b_q4_K_M_5th_32kc": {
					"name": "Qwen3 8B Q4 K M (5 Threads 32K Context)"
				},
				"qwen3:8b-q4_K_M_4000th_20kc": {
					"name": "Qwen3 8B Q4 K M (4000 Threads 20K Context)"
				},

				"qwen3:1.7b": { "name": "Qwen3 1.7B" },

				"ministral-3:3b": { "name": "Ministral 3 3B" },
				"ministral-3:8b_16kc": { "name": "Ministral 3 8B (16K Context)" },
				"llama3.2:3b": { "name": "Llama3.2 3B" },
				"gpt-oss:20b": { "name": "gpt-oss:20b" }
			}
		}
	},

	"keybinds": {
		"input_newline": "return",
		"input_submit": "alt+return"
	}
}
