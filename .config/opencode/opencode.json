{
	"$schema": "https://opencode.ai/config.json",
	"model": "ollama.homenet/glm-4.7-flash:5th_32kc",
	"provider": {

		"lmstudio.homenet": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "LMStudio (HomeNet)",
			"options": {
				"baseURL": "http://homenet:1234/v1"
			},
			"models": {
				"loaded": {
					"name": "What ever LMStudio has currently loaded"
				}
			}

		},

		"ollama.local": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama (Local)",
			"options": {
				"baseURL": "http://localhost:11434/v1"
			},
			"models": {
				"qwen3:1.7b-q8_0": {
					"name": "Qwen3 1.7B"
				}
			}
		},

		"ollama.homenet": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama (HomeNet)",
			"options": {
				"baseURL": "http://homenet:11434/v1"
			},
			"models": {

				"NeuroEquality/neuralquantum-coder:latest": { "name": "Neuralquantum-Coder" },
				"qwen3-coder:30b-a3b-q4_K_M": { "name": "Qwen3-Coder 30b" },
				"glm-4.7-flash:5th_32kc": { "name": "GLM 4.7 Flash (5 Threads 32K Context)" },

				"gemma3:4b": { "name": "Gemma3 4B (no tools, don't use)" },

				"qwen3:1.7b-q8_0": { "name": "Qwen3 1.7B Q8" },
				"qwen3:1.7b": { "name": "Qwen3 1.7B" },
				"qwen3:4b_64th_32kc": { "name": "Qwen3 4B (64 Threads 32K Context)" },
				"qwen3:8b-q4_K_M": { "name": "Qwen3 8B Q4 K M" },
				"ministral-3:3b": { "name": "Ministral 3 3B" },
				"llama3.2:3b": { "name": "Llama3.2 3B" }

			}
		}

	},

	"keybinds": {
		"input_newline": "return",
		"input_submit": "alt+return"
	}


}
