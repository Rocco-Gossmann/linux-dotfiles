{
	"$schema": "https://opencode.ai/config.json",
	"model": "homeai/glm-4.7-flash",
	"provider": {

		"ollama": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama (Local)",
			"options": {
				"baseURL": "http://localhost:11434/v1"
			},
			"models": {
				"qwen3:1.7b-q8_0": {
					"name": "Qwen3 1.7B",
				}
			}
		},

		"homeai": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama (HomeAI)",
			"options": {
				"baseURL": "http://homenet:11434/v1"
			},
			"models": {
				"gemma3:4b": {
					"name": "Gemma3 4B"
				},
				"qwen3:1.7b-q8_0": {
					"name": "Qwen3 1.7B Q8"
				},
				"qwen3:1.7b": {
					"name": "Qwen3 1.7B",
				},
				"qwen3:4b": {
					"name": "Qwen3 4B",
				},
				"qwen3:8b": {
					"name": "Qwen3 8B",
				},
				"bjoernb/qwen3-coder-30b:latest": {
					"name": "Qwen3-Coder 30b"
				},
				"ministral-3:3b": {
					"name": "Ministral 3 3B"
				},
				"ministral-3:8b": {
					"name": "Ministral 3 8B"
				},
				"llama3.2:3b": {
					"name": "Llama3.2 3B"
				},
				"cogito:8b": {
					"name": "Cogito 8B"
				},
				"glm-4.7-flash": {
					"name": "GLM 4.7 Flash"
				},
				"NeuroEquality/neuralquantum-coder:latest": {
					"name": "Neuralquantum-Coder"
				}
			}
		}

	},

	"keybinds": {
		"input_newline": "return",
		"input_submit": "alt+return"
	}


