{
	"$schema": "https://opencode.ai/config.json",
	"model": "ollama.homeai_large/glm-4.7-flash:local",

	"agent": {
		"research": {
			"prompt": "{file:./prompts/research.md}"
		}
	},

	"provider": {
		"ollama.homemac": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama (Home - Large)",
			"options": {
				"baseURL": "http://homemac:11434/v1"
			},
			"models": {
				"gemma4:26b": {
					"name": "Gemma 4 26B"
				},
				"local_glm4.7-flash": {
					"name": "GLM-4.7-Flash"
				}
			}
		}
	}

}
