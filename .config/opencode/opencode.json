{
	"$schema": "https://opencode.ai/config.json",
	"model": "ollama.homemac/local_glm-4.7-flash:latest",
	"autoupdate": false,

	"compaction": {
		"auto": true,
		"keep": { "tokens": 15000 }
	},

	"provider": {

		"ollama.homeai": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "HomeAI (Ollama)",
			"limit": {
				"context": 32768
			},
			"options": {
				"baseURL": "http://homeai:11434/v1"
			},
			"models": {
				"local_glm4.7-flash:latest": {
					"name": "GLM-4.7-Flash"
				},
				"gemma4:26b": {
					"name": "Gemma 4 26B",
					"modalities": {
						"input": ["text", "image"],
						"output": ["text"]
					}
				}
			}
		},

		"lmstudio.homeai": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "HomeAI (LMStudio)",
			"options": {
				"baseURL": "http://homeai:1234/v1"
			},
			"models": {
				"lmstudio": {
					"name": "LM Studio",
					"modalities": {
						"input": ["text", "image"],
						"output": ["text"]
					}
				}
			}
		},

		"llama.local": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Local AI (LLamaServer)",
			"options": {
				"baseURL": "http://localhost:9931/v1"
			},
			"models": {
				"llama-serve": {
					"name": "LLama Server",
					"modalities": {
						"input": ["text", "image"],
						"output": ["text"]
					}
				}
			}
		},

		"lmstudio.local": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Local AI (LMStudio)",
			"options": {
				"baseURL": "http://localhost:1234/v1"
			},
			"models": {
				"lmstudio": {
					"name": "LMStudio",
					"modalities": {
						"input": ["text", "image"],
						"output": ["text"]
					}
				}
			}
		}
	}
}
