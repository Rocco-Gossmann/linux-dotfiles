{
	"$schema": "https://opencode.ai/config.json",
	"model": "ollama.homenet/glm-4.7-flash:8th_30kc",

	"agent": {

		"research": {
			"prompt": "{file:./prompts/research.md}"
		}

	},

	"provider": {

		"ollama.local": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama (Local)",
			"options": {
				"baseURL": "http://localhost:11434/v1"
			},
			"models": {
				"qwen3:1.7b-q8_0": { "name": "Qwen3 1.7B (Q8) " },
				"granite4:3b": { "name": "Granite4 3B" }
			}
		},

		"ollama.homenet": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama (HomeNet)",
			"options": {
				"baseURL": "http://homemac:11434/v1"
			},
			"models": {
				"glm-4.7-flash:8th_30kc": {
					"name": "GLM 4.7 Flash (8 Threads 30K Context)"
				},
				"lfm2:24b": {
					"name": "LFM 2 24B"
				},
				"lfm2:24b_8th_30kc": {
					"name": "LFM 2 24B (8 Threads, 30K Context)"
				},
				"ministral-3:8b_16kc": {
					"name": "Ministral 3 8B (16K Context)"
				},
				"ministral-3:8b_20kc": {
					"name": "Ministral 3 8B (20K Context)"
				},
				"ministral-3:8b": {
					"name": "Ministral 3 8B"
				},
				"devstral:latest": {
					"name": "Devstral Latest"
				},
				"qwen3-coder:30b_q4_5th_32kc": {
					"name": "Qwen3-Coder 30B Q4 (5 Threads 32K Context)"
				},
				"gpt-oss:20b": {
					"name": "GPT-OSS 20B"
				},
				"NeuroEquality/neuralquantum-coder:latest": {
					"name": "Neuralquantum Coder Latest"
				}
			}
		}
	},

	"keybinds": {
		"input_newline": "return",
		"input_submit": "alt+return"
	}
}
