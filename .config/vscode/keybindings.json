	{ "key": "alt-n", "command": "workbench.action.toggleSidebarVisibility", "when": "listFocus && explorerViewletFocus" },

	{ "key": "m a", "command": "explorer.newFile", "when": "listFocus && explorerViewletFocus && !inputFocus" },
