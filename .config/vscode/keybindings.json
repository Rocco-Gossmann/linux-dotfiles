	{ "key": "shift+alt+k", "command": "workbench.action.moveEditorToAboveGroup" },
	{ "key": "shift+alt+l", "command": "workbench.action.moveEditorToRightGroup" },

	{ "key": "ctrl-n", "command": "workbench.view.explorer", "when": "!filesExplorerFocus && !suggestWidgetVisible && !inQuickOpen && !terminalFocus" },
	{ "key": "alt-n", "command": "workbench.view.explorer", "when": "!filesExplorerFocus && !suggestWidgetVisible && !inQuickOpen && terminalFocus" },
