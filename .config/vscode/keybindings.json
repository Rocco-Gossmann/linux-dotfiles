	{ "key": "pageDown", "command": "workbench.action.terminal.focusNext",  "when": "terminalFocus" },
	{ "key": "pageUp", "command": "workbench.action.terminal.focusPrevious", "when": "terminalFocus" },

	{ "key": "alt-shift-i", "command": "workbench.action.createTerminalEditorSide", "when": "terminalFocus" },
	{ "key": "alt-shift-w", "command": "workbench.action.createTerminalEditor", "when": "terminalFocus" },
	{ "key": "alt-shift--", "command": "runCommands", "args": {
		"commands": [
			"workbench.action.createTerminalEditor",
			"workbench.action.splitEditorDown",
			"workbench.action.navigateUp",
			"workbench.action.moveEditorToBelowGroup"
		]
	}, "when": "terminalFocus" },

	{ "key": "alt-shift-i", "command": "workbench.action.splitEditorRight"     , "when": "!terminalFocus"},
	{ "key": "alt-shift-w", "command": "workbench.action.createTerminalEditor" , "when": "!terminalFocus"},
	{ "key": "alt-shift--", "command": "workbench.action.splitEditorDown"      , "when": "!terminalFocus"},

	{ "key": "shift+alt+h", "command": "workbench.action.moveEditorToLeftGroup"  },
