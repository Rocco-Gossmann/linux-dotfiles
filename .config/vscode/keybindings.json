[
	{ "key": "ctrl+h", "command": "workbench.action.navigateLeft" , "when": "!terminalFocus" },
	{ "key": "ctrl+j", "command": "workbench.action.navigateDown" , "when": "!terminalFocus" },
	{ "key": "ctrl+k", "command": "workbench.action.navigateUp"   , "when": "!terminalFocus" },
	{ "key": "ctrl+l", "command": "workbench.action.navigateRight", "when": "!terminalFocus" },

	// passing ctrl+space in case a terminal uses my Tmux-setup
	{ "key": "ctrl+space ctrl+space", "command": "workbench.action.terminal.sendSequence", "args": {
		"text": "\u0000"
	} },

	{ "key": "ctrl-space p s", "command": "workbench.action.findInFiles", "when": "editorTextFocus" },
	{ "key": "ctrl-space p f", "command": "workbench.action.quickOpen" },

	{ "key": "ctrl-space c c", "command": "editor.action.commentLine", "when": "editorTextFocus && !editorReadonly" },
	{ "key": "ctrl-space c r", "command": "editor.action.rename", "when": "editorTextFocus && !editorReadonly" },

	{ "key": "ctrl-space g r", "command": "editor.action.goToReferences", "when": "editorHasReferenceProvider && !inReferenceSearchEditor && !isInEmbeddedEditor" },

	{ "key": "ctrl-space s v", "command": "workbench.action.splitEditorRight", "when": "!terminalFocus" },
	{ "key": "ctrl-space s h", "command": "workbench.action.splitEditorDown", "when": "!terminalFocus" },

	{ "key": "ctrl+space o r", "command": "openCodeCommunicator.ocreference"},
	{ "key": "ctrl+space o c", "command": "openCodeCommunicator.occopy"},
	{ "key": "ctrl+space o o", "command": "openCodeCommunicator.ocfocus"},

	{ "key": "ctrl+space m m", "command": "terminalrunner.run.make"},
