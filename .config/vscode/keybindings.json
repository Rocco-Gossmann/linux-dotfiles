	{ "key": "m d", "command": "explorer.newFolder", "when": "listFocus && explorerViewletFocus && !inputFocus" },
	{ "key": "m shift+d", "command": "deleteFile", "when": "listFocus && explorerViewletFocus && !inputFocus" },

	{ "key": "cmd+l", "command": "workbench.action.nextEditorInGroup" },
	{ "key": "cmd+h", "command": "workbench.action.previousEditorInGroup" },

	{ "key": "shift+cmd+h", "command": "workbench.action.moveEditorLeftInGroup", "when": "!activeEditorIsFirstInGroup" },
	{ "key": "shift+cmd+h", "command": "workbench.action.moveEditorToLeftGroup", "when": "activeEditorIsFirstInGroup" },
	{ "key": "shift+cmd+l", "command": "workbench.action.moveEditorRightInGroup", "when": "!activeEditorIsLastInGroup" },
	{ "key": "shift+cmd+l", "command": "workbench.action.moveEditorToRightGroup", "when": "activeEditorIsLastInGroup" },

	{ "key": "shift+cmd+g", "command": "workbench.view.scm"},

	{ "key": "enter", "command": "list.select", "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus" },

	{ "key": "ctrl+d", "command": "cursorPageDown", "when": "!referenceSearchVisible"},
	{ "key": "ctrl+u", "command": "cursorPageUp", "when": "!referenceSearchVisible"},

	{ "key": "pageDown", "command": "workbench.action.terminal.focusNext", "when": "terminalFocus" },
	{ "key": "pageUp", "command": "workbench.action.terminal.focusPrevious", "when": "terminalFocus" },

	{ "key": "ctrl+r", "command": "runCommands", "args": {
		"commands": [
			"actions.find",
			"toggleFindInSelection"
		]
	}, "when": "!findWidgetVisible && editorHasSelection" },
	{ "key": "ctrl+r", "command": "editor.action.startFindReplaceAction", "when": "findWidgetVisible" },

	{ "key": "cmd+o", "command": "workbench.action.openRecent"},
	{ "key": "ctrl+s", "command": "workbench.action.files.save" },

	{
		"key": "ctrl+shift+i",
		"command": "workbench.action.terminal.split",
		"when": "terminalFocus && terminalProcessSupported || terminalFocus && terminalWebExtensionContributedProfile"
	},

	// Delete stuff
	//==========================================================================
	{ "key": "cmd+o", "command": "-workbench.action.files.openFolderViaWorkspace", "when": "!openFolderWorkspaceSupport && workbenchState == 'workspace'" },
