	{ "key": "ctrl+space l g", "command": "terminalrunner.run.lazygit"},
	{ "key": "ctrl+space l s", "command": "terminalrunner.run.database"},

	{ "key": "ctrl+space j j", "command": "terminalrunner.run.jujutsuShell"},
