# theme = dark:"Monokai Vivid",light:"rose-pine-dawn"
theme = dark: "Rose Pine DarkBG",light:"Rose Pine Dawn"

shell-integration = zsh

font-family="JetBrainsMono Nerd Font Mono"
font-size=15
macos-option-as-alt="left"
macos-titlebar-style="hidden"
window-padding-x=4
window-padding-y=4
background-opacity=0.90
background-blur=true

# Super + HJKL => change focused split
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# Super + i / - /t  => create new vertical- / horizontal Split or Tab
keybind = ctrl+shift+i=new_split:right
keybind = ctrl+_=new_split:down
keybind = ctrl+shift+w=new_window

# Super + Shift + +/-  => changes current splits font size
keybind = super+plus=unbind
keybind = super+minus=unbind
keybind = ctrl+shift+equal=decrease_font_size:1
keybind = ctrl+shift+plus=increase_font_size:1
