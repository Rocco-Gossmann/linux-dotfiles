// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
	{
		"bindings": {
			// Remove useless default bindings
			"cmd-shift-i": null, // Format
			"cmd-r": null, // AI-Panel
			"cmd-m": null, // Mac Minimize

			// quick open last Projects
			"cmd-o": "projects::OpenRecent",

			// item navigation
			"cmd-h": "pane::ActivatePreviousItem",
			"cmd-l": "pane::ActivateNextItem"
		}
	},

	{
		"context": "!ProjectPanel",
		"bindings": {
			"cmd-n": "project_panel::ToggleFocus"
		}
	},

	{
		"context": "ProjectPanel",
		"bindings": {
			"cmd-n": "workspace::ToggleLeftDock",
			"m a d": "project_panel::NewDirectory",
			"m a f": "project_panel::NewFile",
			"m m": "project_panel::Rename",
			"m d d": "project_panel::Trash"
		}
	},

	{
		"context": "!GitPanel",
		"bindings": {
			"cmd-g": "git_panel::ToggleFocus"
		}
	},

	{
		"context": "GitPanel",
		"bindings": {
			"cmd-g": "workspace::ToggleLeftDock"
		}
	},

	{
		"context": "Editor && vim_mode==normal",
		"bindings": {
			//Code Actions (c)
			"space c c": "editor::ToggleComments",
			"space c r": "editor::Rename",

			//Git Actions (g)
			"space g b": "git::Blame",
			"space g s": "git::StageAndNext",
			"space g u": "git::UnstageAndNext",
			"space g d": "git::Diff",
			"space g c": "git::Commit",
			"space g r": "git::Restore",

			//close commands (Z)
			"shift-z shift-z": [
				"pane::CloseActiveItem",
				{ "save_intent": "close" }
			],
			"shift-z shift-q": [
				"pane::CloseActiveItem",
				{ "save_intent": "skip" }
			],
			"shift-z shift-w": [
				"pane::CloseActiveItem",
				{ "save_intent": "save" }
			],
			"shift-z shift-a": [
				"workspace::CloseAllItemsAndPanes",
				{ "save_intent": "close" }
			]
		}
	},

	{
		"context": "Editor && vim_mode==visual",
		"bindings": {
			"J": "editor::MoveLineDown",
			"K": "editor::MoveLineUp",

			"space c c": ["workspace::SendKeystrokes", "m z g c escape ` z"],

			"ctrl-r": [
				"workspace::SendKeystrokes",
			 	"cmd-f cmd-shift-p search: toggle selection enter cmd-shift-p search: focus search enter"
			]
		}
	},

	{
		"context": "BufferSearchBar",
		"bindings": {
			"ctrl-r": [
				"workspace::SendKeystrokes",
				"cmd-shift-p search: toggle replace enter"
			]
		}
	},

	{
		"context": "!Terminal",
		"bindings": {
			"ctrl-h": "workspace::ActivatePaneLeft",
			"ctrl-j": "workspace::ActivatePaneDown",
			"ctrl-k": "workspace::ActivatePaneUp",
			"ctrl-l": "workspace::ActivatePaneRight"
		}
	},

	{
		"context": "Terminal",
		"bindings": {
			"cmd-k": "workspace::ToggleZoom",

			"ctrl-h": ["terminal::SendKeystroke", "ctrl-h"],
			"ctrl-j": ["terminal::SendKeystroke", "ctrl-j"],
			"ctrl-k": ["terminal::SendKeystroke", "ctrl-k"],
			"ctrl-l": ["terminal::SendKeystroke", "ctrl-l"]
		}
	}
]
