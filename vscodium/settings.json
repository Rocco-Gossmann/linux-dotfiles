{
    //==========================================================================
    // BM: Vim
    //==========================================================================
    "vim.leader": " ",
    "vim.foldfix": true,
    "vim.handleKeys": {
        "<C-d>": true,
        "<C-u>": true,
        "<C-h>": true,
    },
    "vim.normalModeKeyBindingsNonRecursive": [
        { "before": [ "<S-m>" ], "after": [ "m" ] },
        { "before": [ "m" ], "after": [ "`" ] },
        { "before": [ "<S-q>" ], "after": [ "q" ] },
        { "before": [ "q" ], "after": [ "@" ] },

        { "before": [ "<leader>", "<leader>" ], "commands": [ { "command": "workbench.action.showAllEditorsByMostRecentlyUsed" } ] },

        { "before": [ "<leader>", "c", "r" ], "commands": [ { "command": "editor.action.rename" } ] },
        { "before": [ "<leader>", "c", "c" ], "commands": [ { "command": "editor.action.commentLine"} ] },
        { "before": [ "<leader>", "c", "a" ], "commands": [ { "command": "editor.action.quickFix"} ] },
        { "before": [ "<leader>", "c", "f" ], "commands": [ { "command": "editor.action.format"} ] },

        { "before": [ "<leader>", "f", "t" ], "commands": [ { "command": "workbench.action.gotoSymbol" } ] },
        { "before": [ "<leader>", "f", "d" ], "commands": [ { "command": "workbench.action.showErrorsWarnings" } ] },
        { "before": [ "<leader>", "f", "e" ], "commands": [ { "command": "workbench.explorer.fileView.focus" } ] },
        { "before": [ "<leader>", "f", "d" ], "commands": [ { "command": "workbench.action.showErrorsWarnings" } ] },
        { "before": [ "<leader>", "f", "g" ], "commands": [ { "command": "actions.find" } ] },
        { "before": [ "<leader>", "f", "f" ], "commands": [ { "command": "workbench.action.quickOpen" } ] },

        { "before": [ "<leader>", "p", "f" ], "commands": [ { "command": "workbench.action.quickOpen" } ] },
        { "before": [ "<leader>", "p", "s" ], "commands": [ { "command": "workbench.view.search.focus" } ] },
        { "before": [ "<leader>", "p", "w" ],
			"after": [ "v", "i", "w" ],
			"commands": [
				{ "command": "workbench.action.findInFiles" },
				{ "command": "search.action.focusSearchList" }
			]
		},

        { "before": [ "<leader>", "s", "v" ], "commands": [ { "command": "workbench.action.splitEditorRight" } ] },
        { "before": [ "<leader>", "s", "h" ], "commands": [ { "command": "workbench.action.splitEditorDown" } ] },

        { "before": [ "<leader>", "l", "g" ], "commands": [ { "command": "terminalrunner.run.lazygit" } ] },
        { "before": [ "<leader>", "l", "l" ], "commands": [ { "command": "terminalrunner.run.llm"} ] },
        { "before": [ "<leader>", "l", "t" ], "commands": [ { "command": "workbench.action.createTerminalEditorSameGroup"} ] },

        { "before": [ "<leader>", "b" ], "commands": [ { "command": "bookmarkcomments.bm"} ] },
        { "before": [ "<leader>", "o", "o" ], "commands": [ { "command": "openCodeCommunicator.ocfocus"} ] },
        { "before": [ "<leader>", "o", "r" ], "commands": [ { "command": "openCodeCommunicator.ocreference" } ] },

        { "before": [ "g", "r" ], "commands": [ {"command": "editor.action.goToReferences", "when": "editorHasReferenceProvider && !inReferenceSearchEditor && !isInEmbeddedEditor" } ] },

		{ "before": [ "<leader>", "t", "z" ], "commands": [ { "command": "workbench.action.toggleZenMode" } ]}

    ],

    "vim.visualModeKeyBindingsNonRecursive": [
        { "before": [ "<leader>", "o", "r" ], "commands": [ { "command": "openCodeCommunicator.ocreference" } ] },
        { "before": [ "<leader>", "o", "c" ], "commands": [ { "command": "openCodeCommunicator.occopy"} ] },
        { "before": [ "<leader>", "o", "o" ], "commands": [ { "command": "openCodeCommunicator.ocfocus"} ] },
        { "before": [ "<leader>", "p", "w" ], "commands": [ { "command": "runCommands", "args": { "commands": [ "workbench.action.findInFiles", "search.action.focusSearchList" ]}} ] },

        { "before": [ "g", "a" ], "commands": [ {"command": "align.regex" } ] },
    ],

	"vim.insertModeKeyBindingsNonRecursive": [
		{ "before": [ "<C-h>" ], "commands": [ {"command": "editor.action.triggerSuggest" } ] },
	],

    "vim.easymotion": true,
    "vim.gdefault": true,
	"vim.highlightedyank.enable": true,
    "vim.sneak": true,
    "vim.sneakReplacesF": true,
    "vim.useSystemClipboard": true,
	"vim.incsearch": true,
    "vim.autoindent": false,
	"extensions.experimental.affinity": {
		"vscodevim.vim": 1
	},

	//==========================================================================
	// BM: Kanban
	//==========================================================================
	"mdKanban.todoKeywords": [
		"TODO",
		"FIXME",
		"BUG",
		"HACK"
	],

    //==========================================================================
    // BM: Theme / layout
    //==========================================================================
	"workbench.colorTheme": "Catppuccin Mocha",
    "window.zoomLevel": 2,
    "editor.fontSize": 15,
    "terminal.integrated.fontSize": 15,
    "workbench.tabs.experimental.fontSize": 12,
    "workbench.iconTheme": "catppuccin-mocha",
    "workbench.activityBar.location": "top",
    "excalidraw.theme": "light",
    "window.density.editorTabHeight": "compact",
    "window.density.layout": "default",
    "workbench.browser.showInTitleBar": true,
	"workbench.layoutControl.enabled": true,
    "workbench.editor.tabSizing": "shrink",
    "workbench.editor.wrapTabs": true,
	"workbench.editor.editorActionsLocation": "titleBar",
    "workbench.browser.newTabPlacement": "sideGroup",
    "explorer.autoReveal": true,
    "editor.stickyScroll.enabled": false,
    "workbench.editor.highlightModifiedTabs": true,
	"window.commandCenter": false,

	//==============================================================================
	// BM: Background
	//==============================================================================
	"background.enabled": true,
    "background.fullscreen": {
        "images": [ "${HOME}/.config/vscodium/background.png" ],
        "opacity": 0.3,
        "size": "cover",
        "position": "center",
        "styles": [],
        "interval": 0,
        "random": false
    },
    "workbench.colorCustomizations": {
        "editor.background"      : "#020608"  ,
		"editorGutter.background": "#020608"  ,
		"breadcrumb.background"  : "#020608"  ,
		"terminal.background"    : "#020608"  ,
		"panel.background"       : "#020608"  ,
        "tab.activeBorder"       : "#ffff00ff",
        "tab.activeForeground"   : "#a9d2b9"  ,
        "tab.activeBackground"   : "#1f6d3e4d"
    },
    //==========================================================================
    // BM: Editor
    //==========================================================================
    "editor.fontFamily"             : "\"JetBrainsMono Nerd Font Mono\", Menlo, Monaco, 'Courier New', monospace",
    "editor.lineNumbers"            : "relative",
    "editor.minimap.enabled"        : false,
    "workbench.list.smoothScrolling": true,
    "editor.smoothScrolling"        : true,
    "editor.rulers": [
        80,
        120
    ],
    "editor.renderWhitespace": "trailing",
    "editor.autoIndentOnPaste": true,
    "editor.detectIndentation": false,
    "editor.indentSize": "tabSize",
    "editor.useTabStops": true,
    "editor.stickyTabStops": true,
	"editor.tabCompletion": "on",
    "files.trimTrailingWhitespace": true,
	"editor.insertSpaces": false,
	"editor.fontLigatures": true,
	"editor.autoIndent": "keep",
	"editor.wrappingIndent": "indent",
	"editor.foldingStrategy": "indentation",
	"explorer.confirmDelete": false,

    //==========================================================================
    // BM: Misc
    //==========================================================================
    "workbench.quickOpen.preserveInput": true,
    "search.quickOpen.includeHistory": true,
    "workbench.editor.enablePreviewFromQuickOpen": true,
    "search.quickOpen.history.filterSortOrder": "recency",
    "workbench.startupEditor": "none",
    "editor.accessibilitySupport": "off",
	"debug.onTaskErrors": "showErrors",
	"workbench.editor.useModal": "off",
	"zenMode.fullScreen": false,
	"zenMode.hideLineNumbers": false,
	"zenMode.showTabs": "none",

    "align.regex.templates": {
        "Fat Arrow => ": "=>",
        "Thin Arrow -> ": "->",
        "brackets ()": "\\(|\\)",
        "square brackets []": "[|]",
        "curly braces {}": "{|}",
        "Period .": ".",
        "Comma ,": ",",
        "JSON-Object-Line": "{|}|,",
        "Multiple signs": "=|,|:",
        "Trailing comments #": "(?<=\\S.*)\\s+#",
        "Trailing comments //": "(?<=\\S.*)\\s+//",
        "Trailing comments %": "(?<=\\S.*)\\s+%",
    },

	//==========================================================================
	// BM: File Association
	//==========================================================================
	"workbench.editorAssociations": {
		"*.md": "vscode.markdown.preview.editor"
	},

    //==========================================================================
    // BM: Browser
    //==========================================================================
	"workbench.browser.dataStorage": "workspace",
	"workbench.browser.searchEngine": "none",
	"workbench.browser.enableChatTools": false,
	"workbench.browser.openLocalhostLinks": true,
	"workbench.browser.pageZoom": "100%",
	"workbench.browser.sendElementsToChat.attachImages": false,

    //==========================================================================
    // BM: LSP - C# / DotNet
    //==========================================================================
	"dotnet.codeLens.enableReferencesCodeLens": false,
	"dotnet.codeLens.enableTestsCodeLens": false,
	"csharp.inlayHints.enableInlayHintsForTypes": true,
	"dotnet.inlayHints.enableInlayHintsForParameters": true,

    //==========================================================================
    // BM: LSP - Haskell
    //==========================================================================
    "haskell.plugin.class.codeLensOn": false,
    "haskell.plugin.importLens.codeLensOn": false,
    "haskell.plugin.eval.codeLensOn": false,

    //==========================================================================
    // BM: LSP - TS/JS (Javascript/Typescript)
    //==========================================================================
    "js/ts.format.insertSpaceAfterOpeningAndBeforeClosingEmptyBraces": false,
    "js/ts.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": false,

    //==========================================================================
    // BM: Terminal
    //==========================================================================
    "terminal.integrated.commandsToSkipShell": [
        "workbench.action.moveEditorLeftInGroup",
        "workbench.action.moveEditorRightInGroup",
        "workbench.action.moveEditorToBelowGroup",
        "workbench.action.moveEditorToAboveGroup",
        "workbench.action.moveEditorToLeftGroup",
        "workbench.action.moveEditorToRightGroup"
    ],
    "terminal.integrated.smoothScrolling": true,
    "terminalrunner.openasdefault": "tab",
    "terminalrunner.terminals": {
		"lazygit":    { "terminalName": "LazyGit"     , "startCommand": "lazygit"              },
		"lazydocker": { "terminalName": "LazyDocker"  , "startCommand": "lazydocker"           },
		"database":   { "terminalName": "DBUI"        , "startCommand": "nvim -c DBUI"         },
		"ranger":     { "terminalName": "Ranger"      , "startCommand": "ranger"               },
		"neovim":     { "terminalName": "NeoVim"      , "startCommand": "nvim ${file}+${line}" },
        "llm":        { "terminalName": "LLM - Client", "startCommand": "opencode --port 8099" }
	},

	//==========================================================================
	// BM: VSCode-Exclusive
	//==========================================================================
    "claudeCode.preferredLocation": "panel",
    "claudeCode.hideOnboarding": true

}